# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Next.js auto-generated AI agent rules (regenerated by `next dev`)
/AGENTS.md
/CLAUDE.md

# production
/build

# misc
.DS_Store
*.pem
/ivory-crown-tmp

# generated reports from scripts/shopify (regenerate with the scripts)
/docs/shopify/*-report.json
/docs/shopify/*-plan.json
/docs/shopify/offline-preview.json
/docs/shopify/emergency-findings.json
/docs/shopify/option-cleanup.json
/docs/shopify/image-worklist.json
/docs/shopify/snapshot.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Shopify migration snapshots and dry-run reports
/shopify-data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Stripe (use restricted live/test keys — rk_ / rkcs_ preferred)
# Redirect Checkout only needs the secret key (no publishable key).
STRIPE_SECRET_KEY=rk_test_...
# Required for /api/stripe/webhook signature verification
STRIPE_WEBHOOK_SECRET=whsec_...

# Public site URL used for Checkout success/cancel redirects.
# REQUIRED in production — never omit (Host-header fallback is disabled in prod).
NEXT_PUBLIC_SITE_URL=https://ivorycrowncollective.com

# Contact delivery — REQUIRED in production (FormSubmit fallback removed in prod).
CONTACT_TO_EMAIL=phil@ivorycrowncollective.com
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Abuse protection — REQUIRED in production (APIs fail closed without these).
# Turnstile covers both contact and checkout.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

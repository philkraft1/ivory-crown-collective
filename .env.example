# Stripe (use restricted test/live keys — rk_ / rkcs_ preferred)
STRIPE_SECRET_KEY=rk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Public site URL used for Checkout success/cancel redirects
NEXT_PUBLIC_SITE_URL=https://ivorycrowncollective.com

# Public shop link. Keep the myshopify.com fallback until custom DNS is live.
NEXT_PUBLIC_SHOP_URL=https://1wtpc0-c2.myshopify.com

# Optional contact delivery
CONTACT_TO_EMAIL=phil@ivorycrowncollective.com
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Shopify Admin GraphQL migration scripts. Copy to .env.local.
SHOPIFY_STORE_DOMAIN=1wtpc0-c2.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_ADMIN_TOKEN=

# Storefront API token for the site's live product preview feed (read-only,
# public). Create via Shopify Admin > Headless/Storefront API with the
# `unauthenticated_read_product_listings` scope. Without it the site renders
# branded placeholder products instead of live catalog items.
SHOPIFY_STOREFRONT_TOKEN=

# Optional path for local snapshots and dry-run reports.
SHOPIFY_DATA_DIR=shopify-data
